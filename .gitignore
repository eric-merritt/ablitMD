# Run data — keep .gitkeep, ignore actual run files
data/runs/*.json
data/runs/*/
data/runs/*.bak

# Local data — backups, mirrors, generated artifacts, not for git
data/charts/
data/mongo_backup/
data/vastai_mirror/

# Python
__pycache__/
*.pyc
.venv/

# Secrets
.env.keys
backend/.env.keys
frontend/.env.keys

# Node
node_modules/

# Pre-built wheels — in Docker image only, too large for git
pkgs/*.whl

# Local-only — Claude config, not for git
CLAUDE.md
.claude/
docs/superpowers/
